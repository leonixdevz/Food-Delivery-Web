<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In / Sign Up | Foodie.</title>
    <meta
      name="description"
      content="Sign in or sign up to continue shopping and ordering food on Foodie."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="style.css" />
    <link rel="stylesheet" href="auth.css" />
  </head>
  <body>
    <main class="auth-shell">
      <section class="auth-card">
        <div class="auth-aside">
          <div class="auth-brand">
            <div class="brand-badge">🍽️</div>
            <div>
              <h1>Foodie.</h1>
              <p>Sign in or create an account to order your favorites.</p>
            </div>
          </div>
          <img src="images/bike.png" alt="">
          <div class="auth-hero">
            <h2>Welcome back!</h2>
            <p>Sign in to continue browsing restaurants, preview items, and place orders.</p>
          </div>
        </div>

        <div class="auth-form-panel">
          <div class="auth-toggle-row">
            <button class="tab-btn active" id="signInTab" type="button">Sign In</button>
            <button class="tab-btn" id="signUpTab" type="button">Sign Up</button>
          </div>

          <form class="auth-form" id="authForm">
            <div class="form-group" id="emailGroup">
              <label for="authEmail">Email address</label>
              <input id="authEmail" type="email" placeholder="you@example.com" required />
            </div>

            <div class="form-group">
              <label for="authPassword">Password</label>
              <input id="authPassword" type="password" placeholder="Enter password" required />
            </div>

            <button class="btn btn-primary btn-full" id="submitAuth" type="submit">Continue</button>
            <p class="auth-feedback" id="authFeedback" aria-live="polite"></p>
            <p class="auth-note" id="authNote">Don’t have an account yet? Create one now.</p>
          </form>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div>
        <h4>Foodie.</h4>
        <p>Fresh Nigerian food delivered fast. Browse restaurants, preview dishes, and order with confidence.</p>
      </div>
      <div class="footer-links">
        <a href="index.html">Home</a>
        <a href="resturant-page/index.html">Restaurants</a>
        <a href="auth.html">Account</a>
      </div>
    </footer>

    <script src="auth.js"></script>
  </body>
</html>

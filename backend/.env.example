PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/foodie
JWT_SECRET=your_jwt_secret
PAYSTACK_SECRET_KEY=your_paystack_secret
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_CALLBACK_URL=http://localhost:5000/checkout-page/paystack-callback.html
NODE_ENV=development

# ── OPay merchant API (automatic transfer verification) ──
# From your OPay Business Dashboard. When both are set, checkout switches to
# AUTO mode: OPay issues a unique account number per order and verifies
# payments via signed webhook + status API.
# Leave empty to use MANUAL mode (static account number, user-confirmed).
OPAY_MERCHANT_ID=256612345678901
OPAY_PRIVATE_KEY=OPAYPRVxxxxxxxxxxxxxxxxxxxx
# test = staging API, live = production
OPAY_API_MODE=test

# ── OPay manual mode (fallback) ──
# Your static OPay account number shown to customers when merchant API
# credentials are not configured.
OPAY_ACCOUNT_NUMBER=9123456789
OPAY_ACCOUNT_NAME=Foodie.
OPAY_BANK_NAME=OPay

# Public base URL of this backend (used to build the OPay webhook URL)
BACKEND_URL=http://localhost:5000

# SMTP Email Configuration (optional - emails will be logged if not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Foodie <no-reply@foodie.com>
